THUMB_SIZE = (160, 90)  # 一覧のサムネイルの最大の大きさ
LABEL_CHARS = 400  # 一覧の表示用に DB から読む先頭の文字数(全文はプレビューと貼り付けのときに読む)
PREVIEW_DELAY_MS = 80  # ↓キーを押し続けたとき、通り過ぎる画像まで読み込まないための待ち時間


def preview(text, width=100):
    head = text.lstrip()[: width * 4]
    one = " ⏎ ".join(line.strip() for line in head.strip().splitlines())
    return one if len(one) <= width else one[: width - 1] + "…"


class Picker:
    """履歴の一覧(画像はサムネイル付き)と、選択中の項目のプレビューを表示する"""

    COL_ROW, COL_TIME, COL_KIND, COL_LABEL = range(4)

    def __init__(self, db, selection, rows, msg):
        self.db = db
        self.selection = selection
        self.chosen = None
        self.preview_timer = 0
        self.thumb_timer = 0
        self.thumbs = {}  # 行番号 → サムネイル
        self.thumb_queue = []
        self.rows = [r for r, _ in rows]  # (id, 種類, 画像の Path か None)。一覧の行番号で引く
        self.row_of = {r[0]: i for i, r in enumerate(self.rows)}  # id → 行番号
        self.cells = []  # 行番号 → (日時, 種類, 内容の表示)
        for ts, kind_label, label in (r for _, r in rows):
            self.cells.append((time.strftime("%m/%d %H:%M", time.localtime(ts)), kind_label, label))
        # 検索中は、当てはまる行だけの一覧を別に作って差し替える。TreeModelFilter は
        # 行ごとに Python の判定を呼ぶので、1 万行だと絞り込むたびに 0.5 秒ほどかかった
        self.all_store = self.make_store(range(len(self.rows)))
        self.store = self.all_store
        self.view = Gtk.TreeView(model=self.store)
        # TreeView 自身の検索(先頭一致で飛ぶだけ)は使わず、上の検索欄に任せる
        self.view.set_enable_search(False)
        # 列の幅は固定する。自動にすると、GTK が全行の幅を測るので行数に比例して遅くなる
        for title, col, width in ((msg["columns"][0], self.COL_TIME, 100),
                                  (msg["columns"][1], self.COL_KIND, 80)):
            column = Gtk.TreeViewColumn(title, Gtk.CellRendererText(), text=col)
            column.set_sizing(Gtk.TreeViewColumnSizing.FIXED)
            column.set_fixed_width(width)
            self.view.append_column(column)
        content = Gtk.TreeViewColumn(msg["columns"][2])
        content.set_sizing(Gtk.TreeViewColumnSizing.FIXED)
        content.set_expand(True)
        area = content.get_area()
        thumb = Gtk.CellRendererPixbuf(xalign=0)
        # fixed=False にして、サムネイルのないテキストの行は左に詰める
        area.pack_start(thumb, False, False, False)
        content.set_cell_data_func(thumb, self.thumb_cell)
        label = Gtk.CellRendererText()
        area.pack_start(label, True, False, False)
        content.add_attribute(label, "text", self.COL_LABEL)
        self.view.append_column(content)
        self.view.connect("row-activated", self.on_activated)
        self.view.get_selection().connect("changed", self.on_selected)

        self.image = Gtk.Image()
        self.text = Gtk.TextView(editable=False, cursor_visible=False,
                                 wrap_mode=Gtk.WrapMode.WORD_CHAR, left_margin=6, right_margin=6)
        self.stack = Gtk.Stack()
        for name, child in (("image", self.image), ("text", self.text)):
            scroll = Gtk.ScrolledWindow()
            scroll.add(child)
            self.stack.add_named(scroll, name)

        list_scroll = Gtk.ScrolledWindow()
        list_scroll.add(self.view)
        # サムネイルは見えている行の分だけ読み込む
        list_scroll.get_vadjustment().connect("value-changed", self.queue_visible_thumbs)
        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.pack1(list_scroll, True, False)
        paned.pack2(self.stack, True, False)
        paned.set_position(600)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, border_width=6)
        box.pack_start(Gtk.Label(label=msg["text"], xalign=0), False, False, 0)
        self.search = Gtk.SearchEntry(placeholder_text=msg["search"])
        self.search.connect("search-changed", self.on_search)
        self.search.connect("activate", self.activate_cursor)
        self.search.connect("key-press-event", self.on_search_key)
        box.pack_start(self.search, False, False, 0)
        box.pack_start(paned, True, True, 0)

        self.window = Gtk.Window(title=msg["title"], default_width=1100, default_height=680)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.window.set_keep_above(True)
        self.window.add(box)
        self.window.connect("key-press-event", self.on_key)
        self.window.connect("destroy", Gtk.main_quit)
        self.window.show_all()
        self.view.set_cursor(Gtk.TreePath.new_first(), None, False)
        # すぐに打ち込めるよう検索欄にフォーカスを置く(↑↓ と Enter は一覧の操作になる)
        self.search.grab_focus()
        self.window.present()
        self.queue_visible_thumbs()

    def make_store(self, indices):
        store = Gtk.ListStore(int, str, str, str)
        columns = [self.COL_ROW, self.COL_TIME, self.COL_KIND, self.COL_LABEL]
        for i in indices:
            # append より 5 倍ほど速い(1 万行で 550ms → 100ms)
            store.insert_with_valuesv(-1, columns, [i, *self.cells[i]])
        return store

    def thumb_cell(self, _column, cell, model, it, _data):
        i = model[it][self.COL_ROW]
        image = self.rows[i][2] is not None
        cell.set_visible(image)
        # 読み込み前から行の高さをそろえ、読み込んだときに一覧がずれないようにする
        cell.set_fixed_size(*(THUMB_SIZE if image else (-1, -1)))
        cell.props.pixbuf = self.thumbs.get(i)

    def queue_visible_thumbs(self, *_args):
        if not self.thumb_timer:
            self.thumb_timer = GLib.timeout_add(50, self.load_visible_thumbs)

    def load_visible_thumbs(self):
        self.thumb_timer = 0
        visible = self.view.get_visible_range()
        if not visible:
            # 行がまだ並んでいない。少し待ってからやり直す
            self.queue_visible_thumbs()
            return False
        first, last = visible[0].get_indices()[0], visible[1].get_indices()[0]
        # 見えている範囲は、今の一覧での位置。行番号に直して読む
        shown = [self.store[j][self.COL_ROW] for j in range(first, min(last + 3, len(self.store)))]
        self.thumb_queue = [(j, i) for j, i in enumerate(shown, first)
                            if self.rows[i][2] is not None and i not in self.thumbs]
        if self.thumb_queue:
            # 既定の優先度だと、GTK が裏で行の高さを測り終えるまで順番が回ってこない
            GLib.idle_add(self.load_next_thumb, priority=GLib.PRIORITY_HIGH_IDLE)
        return False

    def load_next_thumb(self):
        if not self.thumb_queue:
            return False
        j, i = self.thumb_queue.pop(0)
        if i in self.thumbs:
            return True
        path = self.rows[i][2]
        cache = thumb_path(path)
        pixbuf = None
        try:
            # 大きな画像の縮小は 1 枚 70ms ほどかかるので、一度作ったサムネイルは保存して使い回す
            if cache.exists():
                pixbuf = GdkPixbuf.Pixbuf.new_from_file(str(cache))
            else:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), *THUMB_SIZE, True)
                cache.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
                tmp = cache.with_suffix(".tmp")
                pixbuf.savev(str(tmp), "png", [], [])
                tmp.rename(cache)
        except GLib.Error as e:
            log(f"{path}: サムネイルを作れませんでした: {e.message}")
        self.thumbs[i] = pixbuf
        if j < len(self.store) and self.store[j][self.COL_ROW] == i:  # 検索で一覧が変わっていなければ
            tree_path = Gtk.TreePath.new_from_indices([j])
            self.store.row_changed(tree_path, self.store.get_iter(tree_path))
        return True

    def full_text(self, i):
        row = self.db.execute("SELECT text FROM entries WHERE id = ?", (self.rows[i][0],)).fetchone()
        return row[0] if row else ""

    def on_selected(self, selection):
        model, it = selection.get_selected()
        if it is None:
            return
        i = model[it][self.COL_ROW]
        if self.preview_timer:
            GLib.source_remove(self.preview_timer)
            self.preview_timer = 0
        if self.rows[i][2] is not None:
            self.preview_timer = GLib.timeout_add(PREVIEW_DELAY_MS, self.show_image, self.rows[i][2])
        else:
            self.text.get_buffer().set_text(self.full_text(i))
            self.stack.set_visible_child_name("text")

    def show_image(self, path):
        self.preview_timer = 0
        alloc = self.stack.get_allocation()
        w, h = max(alloc.width - 20, 200), max(alloc.height - 20, 200)
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file(str(path))
            # 元の大きさより拡大はしない。読み込みは 1 回だけにして、縮小はメモリ上で行う
            scale = min(w / pixbuf.get_width(), h / pixbuf.get_height())
            if scale < 1:
                pixbuf = pixbuf.scale_simple(max(1, int(pixbuf.get_width() * scale)),
                                             max(1, int(pixbuf.get_height() * scale)),
                                             GdkPixbuf.InterpType.BILINEAR)
            self.image.set_from_pixbuf(pixbuf)
        except GLib.Error as e:
            self.image.clear()
            log(f"{path}: プレビューを表示できませんでした: {e.message}")
        self.stack.set_visible_child_name("image")
        return False

    def on_activated(self, view, path, _column):
        i = self.store[path][self.COL_ROW]
        self.chosen = self.rows[i][2] or self.full_text(i)
        self.window.destroy()

    def activate_cursor(self, *_args):
        path, _column = self.view.get_cursor()
        if path is not None:
            self.on_activated(self.view, path, None)

    def search_ids(self, words):
        # 本文は全文を対象にする。lower() は ASCII だけを小文字にするが、日本語には影響しない
        where = " AND ".join(
            ["(instr(lower(coalesce(text, '')), ?) > 0 OR instr(lower(coalesce(path, '')), ?) > 0)"]
            * len(words))
        params = [self.selection] + [w for word in words for w in (word, word)]
        return {self.row_of[entry_id] for (entry_id,) in self.db.execute(
            f"SELECT id FROM entries WHERE selection = ? AND {where}", params)
            if entry_id in self.row_of}

    def on_search(self, entry):
        words = entry.get_text().lower().split()
        if words:
            matches = self.search_ids(words)
            self.store = self.make_store(i for i in range(len(self.rows)) if i in matches)
        else:
            self.store = self.all_store
        self.thumb_queue = []
        self.view.set_model(self.store)
        if len(self.store):
            self.view.set_cursor(Gtk.TreePath.new_first(), None, False)
            self.view.scroll_to_point(0, 0)
        else:
            self.image.clear()
            self.text.get_buffer().set_text("")
        self.queue_visible_thumbs()

    def on_search_key(self, _entry, event):
        # 検索欄で ↑↓ や PageUp/PageDown を押したら、一覧のカーソルを動かす
        steps = {Gdk.KEY_Up: (Gtk.MovementStep.DISPLAY_LINES, -1),
                 Gdk.KEY_Down: (Gtk.MovementStep.DISPLAY_LINES, 1),
                 Gdk.KEY_Page_Up: (Gtk.MovementStep.PAGES, -1),
                 Gdk.KEY_Page_Down: (Gtk.MovementStep.PAGES, 1)}
        if event.keyval in steps and len(self.store):
            # move-cursor シグナルは一覧にフォーカスがないと効かないので、位置を計算して動かす
            path, _column = self.view.get_cursor()
            row = path.get_indices()[0] if path else 0
            step, sign = steps[event.keyval]
            visible = self.view.get_visible_range()
            page = (visible[1].get_indices()[0] - visible[0].get_indices()[0]) if visible else 10
            amount = 1 if step == Gtk.MovementStep.DISPLAY_LINES else max(1, page)
            row = max(0, min(len(self.store) - 1, row + sign * amount))
            self.view.set_cursor(Gtk.TreePath.new_from_indices([row]), None, False)
            return True
        return False

    def on_key(self, _window, event):
        if event.keyval == Gdk.KEY_Escape:
            # 検索中なら検索を消す。そうでなければ閉じる
            if self.search.get_text():
                self.search.set_text("")
            else:
                self.window.destroy()
            return True
        # 一覧にフォーカスがあるときに文字を打ったら、検索欄に入れる
        if not self.search.has_focus() and self.search.handle_event(event):
            self.search.grab_focus_without_selecting()
            return True
        return False


def run_pick(args):
    # 一覧は種類ごとに 1 つだけ。既に開いていれば、それを閉じて終わる(Super+V でトグル)
    lock = open(lock_path("clip-history-pick-primary" if args.primary else "clip-history-pick"), "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.seek(0)
        pid = lock.read().strip()
        if pid.isdigit():
            try:
                os.kill(int(pid), signal.SIGTERM)
            except ProcessLookupError:
                pass
        return
    lock.seek(0)
    lock.truncate()
    lock.write(str(os.getpid()))
    lock.flush()

    msg = dict(MESSAGES[is_japanese()])
    if args.primary:
        for key in ("empty", "title", "text"):
            msg[key] = msg[key + "_primary"]
    db = open_db(args.db)
    rows = []  # ((id, 種類, Path か None), (時刻, 種類の表示, 内容の表示))
    for entry_id, ts, kind, head, path in db.execute(
            f"SELECT id, time, kind, substr(text, 1, {LABEL_CHARS}), path FROM entries "
            f"WHERE selection = ? {ORDER}", ("PRIMARY" if args.primary else "CLIPBOARD",)):
        if kind == "image":
            image = Path(path)
            if image.exists():  # 手で消された画像は出さない
                rows.append(((entry_id, kind, image), (ts, msg["kind_image"], image.name)))
        else:
            rows.append(((entry_id, kind, None), (ts, msg["kind_text"], preview(head or ""))))
    if not rows:
        dialog = Gtk.MessageDialog(message_type=Gtk.MessageType.INFO,
                                   buttons=Gtk.ButtonsType.OK, text=msg["empty"])
        dialog.set_keep_above(True)
        dialog.run()
        return

    picker = Picker(db, "PRIMARY" if args.primary else "CLIPBOARD", rows, msg)
    Gtk.main()
    value = picker.chosen
    if value is None:
        return
    # xclip はバックグラウンドに残り、他の誰かがコピーするまでクリップボードを提供し続ける
    selection = "primary" if args.primary else "clipboard"
    if isinstance(value, Path):
        subprocess.run(["xclip", "-selection", selection, "-t", "image/png", "-i", str(value)])
    else:
        subprocess.run(["xclip", "-selection", selection, "-i"], input=value.encode("utf-8"))


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("command", nargs="?", default="daemon", choices=["daemon", "pick"])
    p.add_argument("--image-dir", type=Path, default=default_image_dir(),
                   help="画像の保存先 (既定: ピクチャフォルダ/clipboard)")
    p.add_argument("--db", type=Path, default=default_db(),
                   help="履歴の DB (既定: ~/.local/share/clip-history/history.db)")
    p.add_argument("--keep-images", type=int, default=1000, help="残す画像の枚数 (既定: 1000)")
    p.add_argument("--keep-texts", type=int, default=10000, help="残すテキストの件数 (既定: 10000)")
    p.add_argument("--primary", action="store_true",
                   help="pick で PRIMARY(マウスで選んだ文字)の履歴を出し、選んだものを PRIMARY に戻す")
    p.add_argument("--keep-primary", type=int, default=10000, help="残す PRIMARY の件数 (既定: 10000)")
    # マウスで選んだ文字はすべて残る(端末のパスワードなども)ので、既定では記録しない
    p.add_argument("--record-primary", action="store_true",
                   help="PRIMARY(マウスで選んだ文字)も別の履歴として記録する")
    p.add_argument("--delay-ms", type=int, default=300,
                   help="所有者変更から取得までの待ち時間 (既定: 300)")
    p.add_argument("--primary-delay-ms", type=int, default=1000,
                   help="PRIMARY で、選択が変わらなくなってから取得するまでの待ち時間 (既定: 1000)")
    p.add_argument("--max-image-mb", type=int, default=64,
                   help="これより大きい画像は保存しない (既定: 64)")
    p.add_argument("--max-text-kb", type=int, default=1024,
                   help="これより大きいテキストは保存しない (既定: 1024)")
    p.add_argument("-v", "--verbose", action="store_true", help="イベントごとの詳細ログを出す")
    args = p.parse_args()
    global DEBUG
    DEBUG = args.verbose
    if args.command == "pick":
        run_pick(args)
    else:
        run_daemon(args)


if __name__ == "__main__":
    main()
