#!/usr/bin/env python3
"""クリップボード履歴(テキストと画像)を、xrdp に優しいやり方で記録・呼び出すツール。

  clip-history [daemon]        常駐して CLIPBOARD の変化を記録する (--record-primary で PRIMARY も)
  clip-history pick            CLIPBOARD の履歴を一覧表示し、選んだものを CLIPBOARD に戻す (Super+V 用)
  clip-history pick --primary  PRIMARY の履歴を一覧表示し、選んだものを PRIMARY に戻す (Super+Shift+V 用)

CLIPBOARD はコピー(Ctrl+C)した内容で、Ctrl+V で貼る。xrdp が中継するのはこちらだけ。
PRIMARY はマウスで選んだだけの文字で、中ボタンや端末の Shift+Insert で貼る。

xrdp-chansrv は応答待ちの要求を 1 件しか保持できず、要求が重なると片方が応答されない。
そのため、所有者が変わるたびに TARGETS を確認し、実際に提供されている形式を 1 回だけ要求する。
(clipman は画像で png/jpeg/gif/bmp を順に、CopyQ は同じ形式を 5 回要求していた)
画像は PNG ファイルに保存し、テキストと画像の一覧は SQLite(mode 600)に記録する。
PRIMARY はテキストだけを記録する。
"""
import argparse
import ctypes
import fcntl
import hashlib
import json
import os
import signal
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402

# 優先順。Linux アプリは png を出すことが多く、chansrv は bmp のみ
IMAGE_TARGETS = ["image/png", "image/bmp", "image/jpeg", "image/tiff"]
TEXT_TARGETS = ["UTF8_STRING", "text/plain;charset=utf-8", "STRING"]

DEBUG = False


def debug(msg):
    if DEBUG:
        log(msg)


def log(msg):
    print(f"[{time.strftime('%Y-%m-%dT%H:%M:%S')}] {msg}", file=sys.stderr, flush=True)


def default_image_dir():
    pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
    return Path(pictures or Path.home() / "Pictures") / "clipboard"


def thumb_path(image):
    """一覧用サムネイルのキャッシュの場所。画像のファイル名にはハッシュが入るので名前で対応づける"""
    return Path(GLib.get_user_cache_dir()) / "clip-history" / "thumbs" / image.name


def default_db():
    return Path(GLib.get_user_data_dir()) / "clip-history" / "history.db"


SCHEMA = """
CREATE TABLE IF NOT EXISTS entries (
    id INTEGER PRIMARY KEY,
    selection TEXT NOT NULL,  -- CLIPBOARD / PRIMARY
    time INTEGER NOT NULL,
    kind TEXT NOT NULL,       -- text / image
    text TEXT,                -- kind=text の本文
    path TEXT,                -- kind=image の PNG ファイル
    hash TEXT NOT NULL,       -- 受け取ったデータのハッシュ(重複の判定に使う)
    png_hash TEXT,            -- 保存した PNG のハッシュ(pick で戻した画像の再記録を防ぐ)
    UNIQUE (selection, hash)
);
CREATE INDEX IF NOT EXISTS entries_order ON entries (selection, time DESC, id DESC);
CREATE INDEX IF NOT EXISTS entries_png ON entries (png_hash);
"""

ORDER = "ORDER BY time DESC, id DESC"


def open_db(path):
    """履歴の DB を開く。本文が入るので、ファイルは本人だけが読める権限で作る"""
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.close(os.open(path, os.O_WRONLY | os.O_CREAT, 0o600))
    db = sqlite3.connect(path, timeout=10)
    # WAL なら、常駐プロセスが書いている間も pick が読める(-wal/-shm も DB と同じ権限で作られる)
    db.execute("PRAGMA journal_mode=WAL")
    db.executescript(SCHEMA)
    return db


def text_hash(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def data_hash(data):
    """画像のハッシュ。ファイル名にも入れる"""
    return hashlib.sha256(data).hexdigest()[:12]


def migrate(db, image_dir):
    """JSON 版のテキスト履歴と、DB にまだ無い画像ファイルを取り込む"""
    data_dir = Path(GLib.get_user_data_dir()) / "clip-history"
    with db:
        for name, selection in (("texts.json", "CLIPBOARD"), ("primary.json", "PRIMARY")):
            src = data_dir / name
            if not src.exists():
                continue
            try:
                texts = json.loads(src.read_text(encoding="utf-8"))
            except ValueError:
                texts = []
            # JSON は新しい順なので、古いものから入れる
            for t in reversed(texts):
                db.execute("INSERT OR IGNORE INTO entries (selection, time, kind, text, hash) "
                           "VALUES (?, ?, 'text', ?, ?)",
                           (selection, t["time"], t["text"], text_hash(t["text"])))
            src.rename(src.with_name(name + ".migrated"))
            log(f"{src} の {len(texts)} 件を DB に取り込みました ({name}.migrated として残しています)")
        known = {row[0] for row in db.execute("SELECT path FROM entries WHERE kind = 'image'")}
        added = 0
        for f in sorted(image_dir.glob("*.png")) if image_dir.is_dir() else []:
            if str(f) in known:
                continue
            # ファイル名は 日付-時刻-ハッシュ.png
            digest = f.stem.rsplit("-", 1)[-1]
            db.execute("INSERT OR IGNORE INTO entries (selection, time, kind, path, hash, png_hash) "
                       "VALUES ('CLIPBOARD', ?, 'image', ?, ?, ?)",
                       (int(f.stat().st_mtime), str(f), digest, data_hash(f.read_bytes())))
            added += 1
        if added:
            log(f"{image_dir} の画像 {added} 枚を DB に登録しました")


class Recorder:
    # 応答が来ないまま待ち続けないための上限
    REQUEST_TIMEOUT_MS = 30000
    # PRIMARY で、直前の記録を伸ばした/縮めただけの選択を同じ 1 件として扱う時間
    MERGE_WINDOW_S = 30

    def __init__(self, args, db, primary=False):
        """primary=False なら CLIPBOARD(テキストと画像)、True なら PRIMARY(テキストのみ)を記録する"""
        self.name = "PRIMARY" if primary else "CLIPBOARD"
        self.db = db
        self.images = not primary
        # ドラッグ中の途中の選択を 1 件ずつ残さないよう、PRIMARY は前の記録と統合する
        self.merge = primary
        self.image_dir = args.image_dir
        self.keep_images = args.keep_images
        self.keep_texts = args.keep_primary if primary else args.keep_texts
        self.delay_ms = args.primary_delay_ms if primary else args.delay_ms
        self.max_image = args.max_image_mb * 1024 * 1024
        self.max_text = args.max_text_kb * 1024
        self.clipboard = Gtk.Clipboard.get(Gdk.SELECTION_PRIMARY if primary else Gdk.SELECTION_CLIPBOARD)
        self.timer = 0
        self.watchdog = 0
        self.req = 0  # 現在の要求の番号。古い要求への遅れた応答を無視するため
        self.busy = False
        self.pending = False
        self.clipboard.connect("owner-change", self.on_owner_change)

    def on_owner_change(self, _clipboard, event):
        debug(f"{self.name}: owner-change reason={event.reason}")
        # 連続した所有者変更はまとめて 1 回だけ処理する
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(self.delay_ms, self.check)

    def check(self):
        self.timer = 0
        if self.busy:
            # 前の要求の応答待ち中は重ねて要求しない
            self.pending = True
            return False
        self.busy = True
        self.req += 1
        self.watchdog = GLib.timeout_add(self.REQUEST_TIMEOUT_MS, self.on_timeout, self.req)
        # request_targets は使わない。応答が失敗すると、コールバックが atoms=NULL・個数=-1 で
        # 呼ばれ、PyGObject がその配列を変換するときに segfault する(PyGObject 3.58.1、GTK 3.24.52 で確認)。
        # TARGETS を普通のデータとして要求し、長さを確かめてから読む
        self.clipboard.request_contents(Gdk.Atom.intern("TARGETS", False), self.on_targets, self.req)
        return False

    def on_timeout(self, req):
        self.watchdog = 0
        log(f"{self.name}: 要求 {req} の応答がありません。待ちを解除します")
        self.finish(req)
        return False

    def finish(self, req):
        if req != self.req or not self.busy:
            return
        if self.watchdog:
            GLib.source_remove(self.watchdog)
            self.watchdog = 0
        self.busy = False
        if self.pending:
            self.pending = False
            self.check()

    def on_targets(self, _clipboard, selection, req):
        if req != self.req:
            return
        names = []
        if selection and selection.get_length() > 0:
            ok, atoms = selection.get_targets()
            if ok:
                names = [a.name() for a in atoms]
        debug(f"{self.name}: targets={names}")
        # 画像とテキストの両方があれば画像を優先する(ブラウザの画像コピーなど)
        candidates = IMAGE_TARGETS + TEXT_TARGETS if self.images else TEXT_TARGETS
        target = next((t for t in candidates if t in names), None)
        if target is None:
            self.finish(req)
            return
        self.clipboard.request_contents(
            Gdk.Atom.intern(target, False), self.on_contents, (req, target)
        )

    def on_contents(self, _clipboard, selection, user_data):
        req, target = user_data
        if req != self.req:
            return
        try:
            # 失敗した応答は length < 0。この状態で get_data を呼ぶと GLib が警告を出す
            length = selection.get_length() if selection else -1
            debug(f"{self.name} {target}: length={length}")
            limit = self.max_image if target.startswith("image/") else self.max_text
            if length <= 0:
                log(f"{self.name} {target}: データを取得できませんでした (length={length})")
            elif length > limit:
                log(f"{self.name} {target}: {length} bytes は上限超過のため保存しません")
            elif target.startswith("image/"):
                self.save_image(selection.get_data(), target)
            else:
                self.save_text(selection.get_data(), target)
        except Exception as e:  # 常駐を止めないため、失敗はログだけ残す
            log(f"{self.name} {target}: 保存に失敗しました: {e}")
        self.finish(req)

    def save_text(self, data, target):
        enc = "latin-1" if target == "STRING" else "utf-8"
        text = data.decode(enc, errors="replace")
        if not text.strip():
            return
        now = int(time.time())
        with self.db:
            if self.merge:
                last = self.db.execute(
                    f"SELECT id, time, text FROM entries WHERE selection = ? {ORDER} LIMIT 1",
                    (self.name,)).fetchone()
                if last and last[2] is not None and now - last[1] <= self.MERGE_WINDOW_S \
                        and extends(last[2], text):
                    self.db.execute("DELETE FROM entries WHERE id = ?", (last[0],))
            # 同じテキストは新しく記録せず、先頭に移す
            self.db.execute(
                "INSERT INTO entries (selection, time, kind, text, hash) VALUES (?, ?, 'text', ?, ?) "
                "ON CONFLICT (selection, hash) DO UPDATE SET time = excluded.time",
                (self.name, now, text, text_hash(text)))
            self.prune("text", self.keep_texts)
        debug(f"{self.name}: テキストを記録 ({len(text)} 文字)")

    def save_image(self, data, target):
        now = int(time.time())
        digest = data_hash(data)
        # 同じ画像か、pick で戻した PNG なら、新しく保存せず先頭に移す
        row = self.db.execute(
            "SELECT id, path FROM entries WHERE selection = ? AND (hash = ? OR png_hash = ?)",
            (self.name, digest, digest)).fetchone()
        if row and Path(row[1]).exists():
            with self.db:
                self.db.execute("UPDATE entries SET time = ? WHERE id = ?", (now, row[0]))
            return
        self.image_dir.mkdir(parents=True, exist_ok=True)
        path = self.image_dir / f"{time.strftime('%Y%m%d-%H%M%S')}-{digest}.png"
        tmp = path.with_suffix(".tmp")
        if target == "image/png":
            tmp.write_bytes(data)
        else:
            loader = GdkPixbuf.PixbufLoader()
            loader.write(data)
            loader.close()
            loader.get_pixbuf().savev(str(tmp), "png", [], [])
        tmp.rename(path)
        with self.db:
            if row:  # ファイルが消えていた古い記録
                self.db.execute("DELETE FROM entries WHERE id = ?", (row[0],))
            self.db.execute(
                "INSERT INTO entries (selection, time, kind, path, hash, png_hash) "
                "VALUES (?, ?, 'image', ?, ?, ?)",
                (self.name, now, str(path), digest, data_hash(path.read_bytes())))
            self.prune("image", self.keep_images)
        log(f"画像を保存: {path} ({target}, {len(data)} bytes)")

    def prune(self, kind, keep):
        """新しいものから keep 件を残して消す。画像はファイルとサムネイルも消す"""
        old = self.db.execute(
            f"SELECT id, path FROM entries WHERE selection = ? AND kind = ? {ORDER} LIMIT -1 OFFSET ?",
            (self.name, kind, keep)).fetchall()
        for entry_id, path in old:
            self.db.execute("DELETE FROM entries WHERE id = ?", (entry_id,))
            if path:
                Path(path).unlink(missing_ok=True)
                thumb_path(Path(path)).unlink(missing_ok=True)


def extends(old, new):
    """new が old を伸ばした、または縮めただけの選択か(先頭か末尾を共有している)"""
    return new.startswith(old) or new.endswith(old) or old.startswith(new) or old.endswith(new)


def lock_path(name):
    """ディスプレイごとの lock ファイルのパス"""
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
    display = os.environ.get("DISPLAY", "").replace(":", "").replace("/", "_")
    return runtime / f"{name}.{display}.lock"


# --- Xlib を直接使う部分(ショートカットキーと、tilda の内側への表示) ---
#
# tilda のように、フォーカスを失うと隠れる端末から一覧を開くと、端末が隠れてしまう。
# 隠れるきっかけは 2 つある。
#   1. デスクトップのショートカット(画面全体への XGrabKey)は、キーを押した瞬間に
#      フォーカスのあるウィンドウへ FocusOut(mode=NotifyGrab)を送る。GTK はこれを
#      フォーカスが外れたものとして扱う
#   2. 一覧がフォーカスを取る
# そこで、端末が前面にあるときは、キーを端末のウィンドウ上で取り(グラブ先とフォーカスが
# 同じなので FocusOut が出ない)、一覧は端末のウィンドウの子にしてフォーカスを渡す
# (子へのフォーカス移動は、端末からはフォーカスが外れたように見えない)。

class XErrorEvent(ctypes.Structure):
    _fields_ = [("type", ctypes.c_int), ("display", ctypes.c_void_p),
                ("resourceid", ctypes.c_ulong), ("serial", ctypes.c_ulong),
                ("error_code", ctypes.c_ubyte), ("request_code", ctypes.c_ubyte),
                ("minor_code", ctypes.c_ubyte)]


class XAnyEvent(ctypes.Structure):
    _fields_ = [("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
                ("display", ctypes.c_void_p), ("window", ctypes.c_ulong)]


class XKeyEvent(ctypes.Structure):
    _fields_ = XAnyEvent._fields_ + [
        ("root", ctypes.c_ulong), ("subwindow", ctypes.c_ulong), ("time", ctypes.c_ulong),
        ("x", ctypes.c_int), ("y", ctypes.c_int), ("x_root", ctypes.c_int), ("y_root", ctypes.c_int),
        ("state", ctypes.c_uint), ("keycode", ctypes.c_uint), ("same_screen", ctypes.c_int)]


class XPropertyEvent(ctypes.Structure):
    _fields_ = XAnyEvent._fields_ + [("atom", ctypes.c_ulong), ("time", ctypes.c_ulong),
                                     ("state", ctypes.c_int)]


class XModifierKeymap(ctypes.Structure):
    _fields_ = [("max_keypermod", ctypes.c_int), ("modifiermap", ctypes.POINTER(ctypes.c_ubyte))]


class XClientMessageEvent(ctypes.Structure):
    _fields_ = XAnyEvent._fields_ + [("message_type", ctypes.c_ulong), ("format", ctypes.c_int),
                                     ("data", ctypes.c_long * 5)]


X_KEY_PRESS, X_KEY_RELEASE, X_PROPERTY_NOTIFY, X_CLIENT_MESSAGE = 2, 3, 28, 33
X_MODIFIERS = {"shift": 1, "control": 4, "ctrl": 4, "alt": 8, "mod1": 8, "super": 64, "mod4": 64}
# XTEST で修飾キーを押すときに使うキー
X_MODIFIER_KEYSYMS = {1: b"Shift_L", 4: b"Control_L", 8: b"Alt_L", 64: b"Super_L"}
X_IGNORED_MODS = (0, 2, 16, 2 | 16)  # CapsLock と NumLock の状態に関係なく反応させる
X_ERROR_HANDLER = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.POINTER(XErrorEvent))


class X11:
    """GTK とは別の Xlib 接続。エラーは自分の呼び出しの間だけ横取りする

    Xlib のエラーハンドラはプロセスで 1 つなので、GDK のハンドラを置き換えたままにはしない
    (GDK のハンドラは、知らない接続のエラーを受けるとプロセスを終了させる)。
    """

    def __init__(self):
        lib = self.lib = ctypes.CDLL("libX11.so.6")
        P, W, I, U = ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_uint
        for name, res, argtypes in (
                ("XOpenDisplay", P, [ctypes.c_char_p]),
                ("XDefaultRootWindow", W, [P]),
                ("XConnectionNumber", I, [P]),
                ("XInternAtom", W, [P, ctypes.c_char_p, I]),
                ("XStringToKeysym", W, [ctypes.c_char_p]),
                ("XKeysymToKeycode", ctypes.c_ubyte, [P, W]),
                ("XGrabKey", I, [P, I, U, W, I, I, I]),
                ("XUngrabKey", I, [P, I, U, W]),
                ("XSelectInput", I, [P, W, ctypes.c_long]),
                ("XPending", I, [P]),
                ("XNextEvent", I, [P, P]),
                ("XSync", I, [P, I]),
                ("XFlush", I, [P]),
                ("XGetWindowProperty", I, [P, W, W, ctypes.c_long, ctypes.c_long, I, W,
                                           ctypes.POINTER(W), ctypes.POINTER(I),
                                           ctypes.POINTER(ctypes.c_ulong),
                                           ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(P)]),
                ("XFree", I, [P]),
                ("XReparentWindow", I, [P, W, W, I, I]),
                ("XSetInputFocus", I, [P, W, I, W]),
                ("XGetGeometry", I, [P, W, ctypes.POINTER(W), ctypes.POINTER(I), ctypes.POINTER(I),
                                     ctypes.POINTER(U), ctypes.POINTER(U), ctypes.POINTER(U),
                                     ctypes.POINTER(U)]),
                ("XkbSetDetectableAutoRepeat", I, [P, I, P]),
                ("XQueryPointer", I, [P, W, ctypes.POINTER(W), ctypes.POINTER(W),
                                      ctypes.POINTER(I), ctypes.POINTER(I), ctypes.POINTER(I),
                                      ctypes.POINTER(I), ctypes.POINTER(U)]),
                ("XSendEvent", I, [P, W, I, ctypes.c_long, P]),
                ("XQueryKeymap", I, [P, ctypes.c_char_p]),
                ("XGetModifierMapping", ctypes.POINTER(XModifierKeymap), [P]),
                ("XFreeModifiermap", I, [ctypes.POINTER(XModifierKeymap)]),
                ("XSetErrorHandler", P, [P])):
            fn = getattr(lib, name)
            fn.restype, fn.argtypes = res, argtypes
        self.dpy = lib.XOpenDisplay(None)
        if not self.dpy:
            raise RuntimeError("X に接続できません")
        self.root = lib.XDefaultRootWindow(self.dpy)
        self.errors = []
        self._handler = X_ERROR_HANDLER(self._on_error)  # GC されないよう保持する

    def _on_error(self, _dpy, ev):
        e = ev.contents
        self.errors.append((e.error_code, e.request_code, e.resourceid))
        return 0

    def call(self, name, *args):
        """Xlib の関数を呼び、同期してエラーを集める"""
        old = self.lib.XSetErrorHandler(ctypes.cast(self._handler, ctypes.c_void_p))
        try:
            result = getattr(self.lib, name)(self.dpy, *args)
            self.lib.XSync(self.dpy, 0)
        finally:
            self.lib.XSetErrorHandler(old)
        return result

    def take_errors(self):
        errors, self.errors = self.errors, []
        return errors

    def atom(self, name):
        return self.lib.XInternAtom(self.dpy, name.encode(), 0)

    def property(self, window, name, fmt_type):
        """ウィンドウのプロパティを (形式, バイト列) で返す。なければ None"""
        actual, fmt = ctypes.c_ulong(), ctypes.c_int()
        n, after, data = ctypes.c_ulong(), ctypes.c_ulong(), ctypes.c_void_p()
        status = self.call("XGetWindowProperty", window, self.atom(name), 0, 1024, 0, fmt_type,
                           ctypes.byref(actual), ctypes.byref(fmt), ctypes.byref(n),
                           ctypes.byref(after), ctypes.byref(data))
        if self.take_errors() or status != 0 or not data.value:
            return None
        try:
            size = {8: 1, 16: ctypes.sizeof(ctypes.c_short), 32: ctypes.sizeof(ctypes.c_long)}[fmt.value]
            return fmt.value, ctypes.string_at(data.value, size * n.value)
        finally:
            self.lib.XFree(data)

    def active_window(self):
        prop = self.property(self.root, "_NET_ACTIVE_WINDOW", 33)  # XA_WINDOW
        if not prop or len(prop[1]) < ctypes.sizeof(ctypes.c_ulong):
            return 0
        return ctypes.c_ulong.from_buffer_copy(prop[1][:ctypes.sizeof(ctypes.c_ulong)]).value

    def wm_class(self, window):
        prop = self.property(window, "WM_CLASS", 31)  # XA_STRING
        if not prop:
            return []
        return [s.decode("latin-1").lower() for s in prop[1].split(b"\0") if s]

    def geometry(self, window):
        root, x, y = ctypes.c_ulong(), ctypes.c_int(), ctypes.c_int()
        w, h, border, depth = ctypes.c_uint(), ctypes.c_uint(), ctypes.c_uint(), ctypes.c_uint()
        ok = self.call("XGetGeometry", window, ctypes.byref(root), ctypes.byref(x), ctypes.byref(y),
                       ctypes.byref(w), ctypes.byref(h), ctypes.byref(border), ctypes.byref(depth))
        if self.take_errors() or not ok:
            return None
        return w.value, h.value

    def modifier_state(self):
        """今押されている修飾キー(X の state のビット)"""
        root, child, mask = ctypes.c_ulong(), ctypes.c_ulong(), ctypes.c_uint()
        rx, ry, wx, wy = ctypes.c_int(), ctypes.c_int(), ctypes.c_int(), ctypes.c_int()
        self.call("XQueryPointer", self.root, ctypes.byref(root), ctypes.byref(child), ctypes.byref(rx),
                  ctypes.byref(ry), ctypes.byref(wx), ctypes.byref(wy), ctypes.byref(mask))
        self.take_errors()
        return mask.value & (1 | 4 | 8 | 64)

    def xtest(self, keycode, press):
        xtst = ctypes.CDLL("libXtst.so.6")
        xtst.XTestFakeKeyEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
        xtst.XTestFakeKeyEvent(self.dpy, keycode, 1 if press else 0, 0)

    def send_key(self, mask, keycode):
        """修飾キーと一緒にキーを押して離す(XTEST)。届く先はフォーカスのあるウィンドウ"""
        mods = [self.lib.XKeysymToKeycode(self.dpy, self.lib.XStringToKeysym(sym))
                for bit, sym in X_MODIFIER_KEYSYMS.items() if mask & bit]
        for code in mods + [keycode]:
            self.xtest(code, True)
        for code in [keycode] + mods[::-1]:
            self.xtest(code, False)
        self.call("XFlush")
        self.take_errors()

    def release_modifiers(self):
        """押されたままの Shift・Ctrl・Alt・Super を、離したことにする(XTEST)

        ショートカットの Super を押したままだと、送るキーと組み合わさってしまうため。
        あとで本物の Super を離しても、既に離れているので何も起きない。
        """
        keys = ctypes.create_string_buffer(32)
        self.call("XQueryKeymap", keys)
        modmap = self.lib.XGetModifierMapping(self.dpy)
        try:
            per = modmap.contents.max_keypermod
            # 修飾キーの表の行: 0=Shift 2=Control 3=Mod1(Alt) 6=Mod4(Super)
            codes = {modmap.contents.modifiermap[row * per + i] for row in (0, 2, 3, 6) for i in range(per)}
        finally:
            self.lib.XFreeModifiermap(modmap)
        held = [c for c in codes if c and keys.raw[c // 8] & (1 << (c % 8))]
        for code in held:
            self.xtest(code, False)
        self.call("XFlush")
        self.take_errors()
        return held

    def activate(self, window):
        """ウィンドウマネージャに、ウィンドウを前面にしてフォーカスを渡すよう頼む"""
        buf = ctypes.create_string_buffer(192)  # sizeof(XEvent)
        ev = XClientMessageEvent.from_buffer(buf)
        ev.type, ev.send_event, ev.display, ev.window = X_CLIENT_MESSAGE, 1, self.dpy, window
        ev.message_type, ev.format = self.atom("_NET_ACTIVE_WINDOW"), 32
        ev.data[0] = 2  # 要求元はページャ扱い(フォーカスを奪う防止に止められないように)
        # SubstructureRedirectMask | SubstructureNotifyMask
        self.call("XSendEvent", self.root, 0, (1 << 20) | (1 << 19), buf)
        self.take_errors()


def parse_hotkey(spec, x):
    """"Super+V" のような指定を (修飾キー, キーコード) にする"""
    *mods, key = [part.strip() for part in spec.split("+")]
    mask = 0
    for mod in mods:
        if mod.lower() not in X_MODIFIERS:
            raise ValueError(f"知らない修飾キーです: {mod}")
        mask |= X_MODIFIERS[mod.lower()]
    keysym = x.lib.XStringToKeysym(key.encode()) or x.lib.XStringToKeysym(key.lower().encode())
    keycode = x.lib.XKeysymToKeycode(x.dpy, keysym) if keysym else 0
    if not keycode:
        raise ValueError(f"知らないキーです: {key}")
    return mask, keycode


class YakuakeKeepOpen:
    """一覧を開いている間だけ、Yakuake を「フォーカスを失っても引っ込まない」にする

    Yakuake は、自分のウィンドウからフォーカスが外れると引っ込む。tilda と違い、内側に
    出した子の窓にフォーカスを移しても引っ込むので、内側に出す方法は使えない。
    この切り替えは D-Bus に出ていないため、Yakuake 側で割り当てたキーを XTEST で送る。
    切り替えると Yakuake は yakuakerc の [Window] KeepOpen をすぐ書き換えるので、
    それを読んで切り替わったかを確かめる。
    戻せなかったときは印のファイルを残し、次に Yakuake が前面になったときに戻す。
    """

    WAIT_S = 1.5  # 修飾キーが離されるのと、yakuakerc が書き換わるのを待つ上限

    def __init__(self, x, key_spec):
        self.x = x
        self.key = parse_hotkey(key_spec, x)
        self.config = Path(GLib.get_user_config_dir()) / "yakuakerc"
        self.mark = lock_path("clip-history-yakuake-keep-open")  # 戻し待ちの印

    def keep_open(self):
        """yakuakerc の [Window] KeepOpen。読めなければ None

        KDE の設定は既定値と同じ値を書かずに行ごと消す。KeepOpen の既定は true なので、
        行がなければ true(引っ込まない)、false のときだけ行が書かれる。
        """
        try:
            lines = self.config.read_text(encoding="utf-8").splitlines()
        except OSError:
            return None
        section = None
        for line in lines:
            line = line.strip()
            if line.startswith("["):
                section = line
            elif section == "[Window]" and line.startswith("KeepOpen="):
                return line.split("=", 1)[1].strip().lower() == "true"
        return True

    def wait(self, check, seconds=None):
        end = time.monotonic() + (self.WAIT_S if seconds is None else seconds)
        while time.monotonic() < end:
            if check():
                return True
            time.sleep(0.05)
        return check()

    def toggle(self, want):
        """キーを送り、KeepOpen が want になったかを返す"""
        # ショートカットの Super などが押されたままだと、送ったキーと組み合わさってしまう。
        # 手で押すと Super(Mac の Cmd)を離すまで 1 秒以上かかることがあるので、少し待っても
        # 離されなければ、離したことにする
        released = lambda: self.x.modifier_state() == 0  # noqa: E731
        if not self.wait(released, 0.3):
            held = self.x.release_modifiers()
            debug(f"Yakuake: 押されたままの修飾キーを離したことにしました: {held}")
            if not self.wait(released, 0.5):
                log("Yakuake: 修飾キーが押されたままなので、切り替えのキーを送りません")
                return False
        self.x.send_key(*self.key)
        return self.wait(lambda: self.keep_open() == want)

    def before_pick(self):
        """一覧を開く前に呼ぶ。前面は Yakuake であること"""
        if self.mark.exists():
            return  # 前回から引っ込まない設定のまま
        state = self.keep_open()
        if state is None or state:
            return  # 読めない、または利用者が自分で引っ込まない設定にしている
        if self.toggle(True):
            self.mark.touch()
        else:
            log(f"Yakuake: 引っ込まない設定に切り替わりませんでした。{self.config} の KeepOpen と、"
                "Yakuake のショートカット設定を確かめてください")

    def restore(self, window):
        """引っ込まない設定を戻す。window は Yakuake のウィンドウ。戻せたら True"""
        if not self.mark.exists():
            return True
        if self.keep_open() is False:  # 利用者が手で戻した
            self.mark.unlink(missing_ok=True)
            return True
        # キーはフォーカスのあるウィンドウに届くので、Yakuake を前面にしてから送る
        if self.x.active_window() != window:
            self.x.activate(window)
            if not self.wait(lambda: self.x.active_window() == window):
                log("Yakuake: 前面に戻せないので、引っ込まない設定のままにします(次に前面になったときに戻します)")
                return False
        if self.toggle(False):
            self.mark.unlink(missing_ok=True)
            return True
        log("Yakuake: 引っ込まない設定を戻せませんでした(次に前面になったときにやり直します)")
        return False


class Hotkeys:
    """ショートカットキーを受け付けて pick を起動する

    普段は画面全体(ルートウィンドウ)でキーを取る。--embed-class に当てはまるウィンドウ
    (既定は tilda)が前面にあるときは、そのウィンドウ上でキーを取り、一覧をその内側に出す。
    ルートで取ったままだと、そちらが先に反応してしまうので、その間はルートでは取らない。
    --yakuake-keep-open-key があれば、Yakuake が前面のときも Yakuake の上でキーを取り、
    一覧を開いている間だけ Yakuake を引っ込まない設定にする(YakuakeKeepOpen)。
    """

    def __init__(self, args, bindings):
        self.x = X11()
        self.args = args
        self.embed_classes = {c.strip().lower() for c in args.embed_class.split(",") if c.strip()}
        self.keys = {}  # (修飾キー, キーコード) → pick に渡す追加の引数
        for spec, extra in bindings:
            self.keys[parse_hotkey(spec, self.x)] = (spec, extra)
        self.grabbed = None  # キーを取っているウィンドウ
        self.embed = False
        self.yakuake = YakuakeKeepOpen(self.x, args.yakuake_keep_open_key) if args.yakuake_keep_open_key else None
        self.on_yakuake = False  # キーを取っているのが Yakuake のウィンドウか
        self.picks = 0  # 起動して、まだ終わっていない pick の数
        self.restore_to = None  # 一覧がすべて閉じたら、引っ込まない設定を戻す Yakuake のウィンドウ
        self.down = set()
        self.net_active = self.x.atom("_NET_ACTIVE_WINDOW")
        # キーを押し続けたときの自動リピートで、開閉を繰り返さないようにする
        self.x.call("XkbSetDetectableAutoRepeat", 1, None)
        self.x.call("XSelectInput", self.x.root, 1 << 22)  # PropertyChangeMask
        self.update_grab()
        GLib.io_add_watch(self.x.lib.XConnectionNumber(self.x.dpy), GLib.IO_IN, self.on_events)
        log("ショートカット: " + ", ".join(spec for spec, _ in self.keys.values())
            + (f"(前面が {args.embed_class} のときは、その内側に表示)" if self.embed_classes else "")
            + (f"(前面が Yakuake のときは、{args.yakuake_keep_open_key} で引っ込まない設定に切り替える)"
               if self.yakuake else ""))

    def grab(self, window, on):
        for (mask, keycode), (spec, _) in self.keys.items():
            for extra in X_IGNORED_MODS:
                if on:
                    self.x.call("XGrabKey", keycode, mask | extra, window, 0, 1, 1)  # GrabModeAsync
                else:
                    self.x.call("XUngrabKey", keycode, mask | extra, window)
            errors = self.x.take_errors()
            # BadAccess(10): ほかのプログラム(デスクトップのショートカット設定など)が取っている
            if on and any(code == 10 for code, _, _ in errors):
                log(f"{spec} はほかのプログラムが使っています。デスクトップのショートカット設定から外してください")
            elif errors:
                debug(f"{spec}: X のエラー {errors}")

    def update_grab(self):
        active = self.x.active_window()
        classes = set(self.x.wm_class(active)) if active else set()
        embed = bool(self.embed_classes & classes)
        on_yakuake = self.yakuake is not None and "yakuake" in classes
        if on_yakuake and not self.picks:
            # 前回戻せなかった、引っ込まない設定を戻す
            self.yakuake.restore(active)
        target = active if embed or on_yakuake else self.x.root
        if target == self.grabbed:
            return
        if self.grabbed is not None:
            self.grab(self.grabbed, False)
        self.grab(target, True)
        self.grabbed, self.embed, self.on_yakuake = target, embed, on_yakuake
        debug(f"キーを取るウィンドウ: {target:#x}" + (" (内側に表示)" if embed else "")
              + (" (Yakuake)" if on_yakuake else ""))

    def on_events(self, *_args):
        ev = ctypes.create_string_buffer(192)  # sizeof(XEvent)
        while self.x.call("XPending"):
            self.x.call("XNextEvent", ev)
            kind = XAnyEvent.from_buffer(ev).type
            if kind == X_PROPERTY_NOTIFY and XPropertyEvent.from_buffer(ev).atom == self.net_active:
                self.update_grab()
            elif kind in (X_KEY_PRESS, X_KEY_RELEASE):
                key = XKeyEvent.from_buffer(ev)
                if kind == X_KEY_RELEASE:
                    self.down.discard(key.keycode)
                    continue
                if key.keycode in self.down:
                    continue
                self.down.add(key.keycode)
                mask = key.state & ~(2 | 16)
                for (want_mask, keycode), (_spec, extra) in self.keys.items():
                    if keycode == key.keycode and want_mask == mask:
                        self.launch(extra)
        self.x.take_errors()
        return True

    def launch(self, extra):
        argv = [sys.executable, os.path.abspath(sys.argv[0]), "pick", *extra,
                "--db", str(self.args.db)]
        if self.embed:
            argv += ["--embed", str(self.grabbed)]
        if self.on_yakuake:
            self.yakuake.before_pick()
            self.restore_to = self.grabbed
        debug(f"起動: {argv}")
        pid, *_ = GLib.spawn_async(argv, flags=GLib.SpawnFlags.DO_NOT_REAP_CHILD)
        self.picks += 1
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, pid, self.on_pick_exit)

    def on_pick_exit(self, pid, _status):
        GLib.spawn_close_pid(pid)
        self.picks -= 1
        # 一覧を開いたままもう一度キーを押すと、2 つ目の pick が 1 つ目を閉じる。どの pick が
        # 最後に終わっても戻せるよう、すべて閉じた時点で戻す
        if not self.picks and self.restore_to:
            self.yakuake.restore(self.restore_to)
            self.restore_to = None


class Embedder:
    """pick の一覧を、指定のウィンドウ(tilda など)の内側に表示する"""

    def __init__(self, window, parent):
        self.x = X11()
        self.window, self.parent = window, parent

    def place(self, width, height):
        """表示する前に呼ぶ。大きさを親に合わせて決め、親の子にする"""
        size = self.x.geometry(self.parent)
        if size is None:
            return False
        pw, ph = size
        width, height = min(width, pw - 40), min(height, ph - 40)
        self.window.set_size_request(max(width, 300), max(height, 200))
        self.window.realize()
        xid = self.window.get_window().get_xid()
        self.x.call("XReparentWindow", xid, self.parent, max(0, (pw - width) // 2), max(0, (ph - height) // 2))
        if self.x.take_errors():
            return False
        self.window.connect("map-event", lambda *_: self.focus(xid))
        self.window.connect("destroy", lambda *_: self.focus(self.parent))
        return True

    def focus(self, xid):
        # RevertToParent(2): 一覧が消えたら、フォーカスは親(tilda)に戻る
        self.x.call("XSetInputFocus", xid, 2, 0)
        self.x.take_errors()
        return False


def run_daemon(args):
    if not os.environ.get("DISPLAY"):
        sys.exit("DISPLAY が未設定です")
    # 同じディスプレイで二重起動しない
    lock = open(lock_path("clip-history"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit("既に起動しています")
    db = open_db(args.db)
    migrate(db, args.image_dir)
    Recorder(args, db)
    if args.record_primary:
        Recorder(args, db, primary=True)
    bindings = [(spec, extra) for spec, extra in ((args.hotkey, []), (args.primary_hotkey, ["--primary"]))
                if spec]
    if bindings:
        try:
            Hotkeys(args, bindings)
        except (RuntimeError, ValueError) as e:
            log(f"ショートカットを使えません: {e}")
    log(f"監視開始: DISPLAY={os.environ['DISPLAY']} 画像={args.image_dir} DB={args.db}"
        + (" PRIMARY も記録" if args.record_primary else ""))
    Gtk.main()


def is_japanese():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var)
        if value:
            return value.startswith("ja")
    return False


