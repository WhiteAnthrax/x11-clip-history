#!/usr/bin/env python3
"""クリップボード履歴(テキストと画像)を、xrdp に優しいやり方で記録・呼び出すツール。

  clip-history [daemon]        常駐して CLIPBOARD の変化を記録する (--record-primary で PRIMARY も)
  clip-history pick            CLIPBOARD の履歴を一覧表示し、選んだものを CLIPBOARD に戻す (Super+V 用)
  clip-history pick --primary  PRIMARY の履歴を一覧表示し、選んだものを PRIMARY に戻す (Super+Shift+V 用)

CLIPBOARD はコピー(Ctrl+C)した内容で、Ctrl+V で貼る。xrdp が中継するのはこちらだけ。
PRIMARY はマウスで選んだだけの文字で、中ボタンや端末の Shift+Insert で貼る。

xrdp-chansrv は応答待ちの要求を 1 件しか保持できず、要求が重なると片方が応答されない。
そのため、所有者が変わるたびに TARGETS を確認し、実際に提供されている形式を 1 回だけ要求する。
(clipman は画像で png/jpeg/gif/bmp を順に、CopyQ は同じ形式を 5 回要求していた)
画像は PNG ファイルに保存し、テキストと画像の一覧は SQLite(mode 600)に記録する。
PRIMARY はテキストだけを記録する。
"""
import argparse
import fcntl
import hashlib
import json
import os
import signal
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402

# 優先順。Linux アプリは png を出すことが多く、chansrv は bmp のみ
IMAGE_TARGETS = ["image/png", "image/bmp", "image/jpeg", "image/tiff"]
TEXT_TARGETS = ["UTF8_STRING", "text/plain;charset=utf-8", "STRING"]

DEBUG = False


def debug(msg):
    if DEBUG:
        log(msg)


def log(msg):
    print(f"[{time.strftime('%Y-%m-%dT%H:%M:%S')}] {msg}", file=sys.stderr, flush=True)


def default_image_dir():
    pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
    return Path(pictures or Path.home() / "Pictures") / "clipboard"


def thumb_path(image):
    """一覧用サムネイルのキャッシュの場所。画像のファイル名にはハッシュが入るので名前で対応づける"""
    return Path(GLib.get_user_cache_dir()) / "clip-history" / "thumbs" / image.name


def default_db():
    return Path(GLib.get_user_data_dir()) / "clip-history" / "history.db"


SCHEMA = """
CREATE TABLE IF NOT EXISTS entries (
    id INTEGER PRIMARY KEY,
    selection TEXT NOT NULL,  -- CLIPBOARD / PRIMARY
    time INTEGER NOT NULL,
    kind TEXT NOT NULL,       -- text / image
    text TEXT,                -- kind=text の本文
    path TEXT,                -- kind=image の PNG ファイル
    hash TEXT NOT NULL,       -- 受け取ったデータのハッシュ(重複の判定に使う)
    png_hash TEXT,            -- 保存した PNG のハッシュ(pick で戻した画像の再記録を防ぐ)
    UNIQUE (selection, hash)
);
CREATE INDEX IF NOT EXISTS entries_order ON entries (selection, time DESC, id DESC);
CREATE INDEX IF NOT EXISTS entries_png ON entries (png_hash);
"""

ORDER = "ORDER BY time DESC, id DESC"


def open_db(path):
    """履歴の DB を開く。本文が入るので、ファイルは本人だけが読める権限で作る"""
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.close(os.open(path, os.O_WRONLY | os.O_CREAT, 0o600))
    db = sqlite3.connect(path, timeout=10)
    # WAL なら、常駐プロセスが書いている間も pick が読める(-wal/-shm も DB と同じ権限で作られる)
    db.execute("PRAGMA journal_mode=WAL")
    db.executescript(SCHEMA)
    return db


def text_hash(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def data_hash(data):
    """画像のハッシュ。ファイル名にも入れる"""
    return hashlib.sha256(data).hexdigest()[:12]


def migrate(db, image_dir):
    """JSON 版のテキスト履歴と、DB にまだ無い画像ファイルを取り込む"""
    data_dir = Path(GLib.get_user_data_dir()) / "clip-history"
    with db:
        for name, selection in (("texts.json", "CLIPBOARD"), ("primary.json", "PRIMARY")):
            src = data_dir / name
            if not src.exists():
                continue
            try:
                texts = json.loads(src.read_text(encoding="utf-8"))
            except ValueError:
                texts = []
            # JSON は新しい順なので、古いものから入れる
            for t in reversed(texts):
                db.execute("INSERT OR IGNORE INTO entries (selection, time, kind, text, hash) "
                           "VALUES (?, ?, 'text', ?, ?)",
                           (selection, t["time"], t["text"], text_hash(t["text"])))
            src.rename(src.with_name(name + ".migrated"))
            log(f"{src} の {len(texts)} 件を DB に取り込みました ({name}.migrated として残しています)")
        known = {row[0] for row in db.execute("SELECT path FROM entries WHERE kind = 'image'")}
        added = 0
        for f in sorted(image_dir.glob("*.png")) if image_dir.is_dir() else []:
            if str(f) in known:
                continue
            # ファイル名は 日付-時刻-ハッシュ.png
            digest = f.stem.rsplit("-", 1)[-1]
            db.execute("INSERT OR IGNORE INTO entries (selection, time, kind, path, hash, png_hash) "
                       "VALUES ('CLIPBOARD', ?, 'image', ?, ?, ?)",
                       (int(f.stat().st_mtime), str(f), digest, data_hash(f.read_bytes())))
            added += 1
        if added:
            log(f"{image_dir} の画像 {added} 枚を DB に登録しました")


class Recorder:
    # 応答が来ないまま待ち続けないための上限
    REQUEST_TIMEOUT_MS = 30000
    # PRIMARY で、直前の記録を伸ばした/縮めただけの選択を同じ 1 件として扱う時間
    MERGE_WINDOW_S = 30

    def __init__(self, args, db, primary=False):
        """primary=False なら CLIPBOARD(テキストと画像)、True なら PRIMARY(テキストのみ)を記録する"""
        self.name = "PRIMARY" if primary else "CLIPBOARD"
        self.db = db
        self.images = not primary
        # ドラッグ中の途中の選択を 1 件ずつ残さないよう、PRIMARY は前の記録と統合する
        self.merge = primary
        self.image_dir = args.image_dir
        self.keep_images = args.keep_images
        self.keep_texts = args.keep_primary if primary else args.keep_texts
        self.delay_ms = args.primary_delay_ms if primary else args.delay_ms
        self.max_image = args.max_image_mb * 1024 * 1024
        self.max_text = args.max_text_kb * 1024
        self.clipboard = Gtk.Clipboard.get(Gdk.SELECTION_PRIMARY if primary else Gdk.SELECTION_CLIPBOARD)
        self.timer = 0
        self.watchdog = 0
        self.req = 0  # 現在の要求の番号。古い要求への遅れた応答を無視するため
        self.busy = False
        self.pending = False
        self.clipboard.connect("owner-change", self.on_owner_change)

    def on_owner_change(self, _clipboard, event):
        debug(f"{self.name}: owner-change reason={event.reason}")
        # 連続した所有者変更はまとめて 1 回だけ処理する
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(self.delay_ms, self.check)

    def check(self):
        self.timer = 0
        if self.busy:
            # 前の要求の応答待ち中は重ねて要求しない
            self.pending = True
            return False
        self.busy = True
        self.req += 1
        self.watchdog = GLib.timeout_add(self.REQUEST_TIMEOUT_MS, self.on_timeout, self.req)
        # request_targets は使わない。応答が失敗すると、コールバックが atoms=NULL・個数=-1 で
        # 呼ばれ、PyGObject がその配列を変換するときに segfault する(PyGObject 3.58.1、GTK 3.24.52 で確認)。
        # TARGETS を普通のデータとして要求し、長さを確かめてから読む
        self.clipboard.request_contents(Gdk.Atom.intern("TARGETS", False), self.on_targets, self.req)
        return False

    def on_timeout(self, req):
        self.watchdog = 0
        log(f"{self.name}: 要求 {req} の応答がありません。待ちを解除します")
        self.finish(req)
        return False

    def finish(self, req):
        if req != self.req or not self.busy:
            return
        if self.watchdog:
            GLib.source_remove(self.watchdog)
            self.watchdog = 0
        self.busy = False
        if self.pending:
            self.pending = False
            self.check()

    def on_targets(self, _clipboard, selection, req):
        if req != self.req:
            return
        names = []
        if selection and selection.get_length() > 0:
            ok, atoms = selection.get_targets()
            if ok:
                names = [a.name() for a in atoms]
        debug(f"{self.name}: targets={names}")
        # 画像とテキストの両方があれば画像を優先する(ブラウザの画像コピーなど)
        candidates = IMAGE_TARGETS + TEXT_TARGETS if self.images else TEXT_TARGETS
        target = next((t for t in candidates if t in names), None)
        if target is None:
            self.finish(req)
            return
        self.clipboard.request_contents(
            Gdk.Atom.intern(target, False), self.on_contents, (req, target)
        )

    def on_contents(self, _clipboard, selection, user_data):
        req, target = user_data
        if req != self.req:
            return
        try:
            # 失敗した応答は length < 0。この状態で get_data を呼ぶと GLib が警告を出す
            length = selection.get_length() if selection else -1
            debug(f"{self.name} {target}: length={length}")
            limit = self.max_image if target.startswith("image/") else self.max_text
            if length <= 0:
                log(f"{self.name} {target}: データを取得できませんでした (length={length})")
            elif length > limit:
                log(f"{self.name} {target}: {length} bytes は上限超過のため保存しません")
            elif target.startswith("image/"):
                self.save_image(selection.get_data(), target)
            else:
                self.save_text(selection.get_data(), target)
        except Exception as e:  # 常駐を止めないため、失敗はログだけ残す
            log(f"{self.name} {target}: 保存に失敗しました: {e}")
        self.finish(req)

    def save_text(self, data, target):
        enc = "latin-1" if target == "STRING" else "utf-8"
        text = data.decode(enc, errors="replace")
        if not text.strip():
            return
        now = int(time.time())
        with self.db:
            if self.merge:
                last = self.db.execute(
                    f"SELECT id, time, text FROM entries WHERE selection = ? {ORDER} LIMIT 1",
                    (self.name,)).fetchone()
                if last and last[2] is not None and now - last[1] <= self.MERGE_WINDOW_S \
                        and extends(last[2], text):
                    self.db.execute("DELETE FROM entries WHERE id = ?", (last[0],))
            # 同じテキストは新しく記録せず、先頭に移す
            self.db.execute(
                "INSERT INTO entries (selection, time, kind, text, hash) VALUES (?, ?, 'text', ?, ?) "
                "ON CONFLICT (selection, hash) DO UPDATE SET time = excluded.time",
                (self.name, now, text, text_hash(text)))
            self.prune("text", self.keep_texts)
        debug(f"{self.name}: テキストを記録 ({len(text)} 文字)")

    def save_image(self, data, target):
        now = int(time.time())
        digest = data_hash(data)
        # 同じ画像か、pick で戻した PNG なら、新しく保存せず先頭に移す
        row = self.db.execute(
            "SELECT id, path FROM entries WHERE selection = ? AND (hash = ? OR png_hash = ?)",
            (self.name, digest, digest)).fetchone()
        if row and Path(row[1]).exists():
            with self.db:
                self.db.execute("UPDATE entries SET time = ? WHERE id = ?", (now, row[0]))
            return
        self.image_dir.mkdir(parents=True, exist_ok=True)
        path = self.image_dir / f"{time.strftime('%Y%m%d-%H%M%S')}-{digest}.png"
        tmp = path.with_suffix(".tmp")
        if target == "image/png":
            tmp.write_bytes(data)
        else:
            loader = GdkPixbuf.PixbufLoader()
            loader.write(data)
            loader.close()
            loader.get_pixbuf().savev(str(tmp), "png", [], [])
        tmp.rename(path)
        with self.db:
            if row:  # ファイルが消えていた古い記録
                self.db.execute("DELETE FROM entries WHERE id = ?", (row[0],))
            self.db.execute(
                "INSERT INTO entries (selection, time, kind, path, hash, png_hash) "
                "VALUES (?, ?, 'image', ?, ?, ?)",
                (self.name, now, str(path), digest, data_hash(path.read_bytes())))
            self.prune("image", self.keep_images)
        log(f"画像を保存: {path} ({target}, {len(data)} bytes)")

    def prune(self, kind, keep):
        """新しいものから keep 件を残して消す。画像はファイルとサムネイルも消す"""
        old = self.db.execute(
            f"SELECT id, path FROM entries WHERE selection = ? AND kind = ? {ORDER} LIMIT -1 OFFSET ?",
            (self.name, kind, keep)).fetchall()
        for entry_id, path in old:
            self.db.execute("DELETE FROM entries WHERE id = ?", (entry_id,))
            if path:
                Path(path).unlink(missing_ok=True)
                thumb_path(Path(path)).unlink(missing_ok=True)


def extends(old, new):
    """new が old を伸ばした、または縮めただけの選択か(先頭か末尾を共有している)"""
    return new.startswith(old) or new.endswith(old) or old.startswith(new) or old.endswith(new)


def lock_path(name):
    """ディスプレイごとの lock ファイルのパス"""
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
    display = os.environ.get("DISPLAY", "").replace(":", "").replace("/", "_")
    return runtime / f"{name}.{display}.lock"


def run_daemon(args):
    if not os.environ.get("DISPLAY"):
        sys.exit("DISPLAY が未設定です")
    # 同じディスプレイで二重起動しない
    lock = open(lock_path("clip-history"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit("既に起動しています")
    db = open_db(args.db)
    migrate(db, args.image_dir)
    Recorder(args, db)
    if args.record_primary:
        Recorder(args, db, primary=True)
    log(f"監視開始: DISPLAY={os.environ['DISPLAY']} 画像={args.image_dir} DB={args.db}"
        + (" PRIMARY も記録" if args.record_primary else ""))
    Gtk.main()


def is_japanese():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var)
        if value:
            return value.startswith("ja")
    return False


